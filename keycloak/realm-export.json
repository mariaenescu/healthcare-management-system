        "doctor"
      ]
    },
    {
      "username": "patient1",
      "enabled": true,
      "email": "patient1@healthcare.com",
      "firstName": "Jane",
      "lastName": "Smith",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "patient"
      ]
    }
  ]
